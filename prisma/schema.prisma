// NodeByte Crawl — Prisma Schema (MySQL)
// Persistent job storage — survives server restarts.
// Configure connection via DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Async crawl/batch jobs. Stored in DB so they survive server restarts.
model Job {
  id        String   @id @db.VarChar(191)
  type      String   @db.VarChar(50)   // 'crawl' | 'batch'
  status    String   @db.VarChar(50)   // 'scraping' | 'completed' | 'failed'
  total     Int      @default(0)
  completed Int      @default(0)
  data      String   @db.LongText     // JSON: [{url, success, data, error}]
  error     String?  @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  expiresAt DateTime                 @db.DateTime(3)

  @@index([expiresAt])
  @@index([status])
}
