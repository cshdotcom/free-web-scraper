# ============================================================
# NodeByte Crawl — Environment Configuration Example
# ============================================================
# Copy this file to `.env.local` (for the Next.js app) and to
# `mini-services/crawler-service/.env` (for the crawler service),
# then adjust the values as needed.
# ============================================================

# ------------------------------------------------------------
# Next.js app configuration (put in .env.local)
# ------------------------------------------------------------

# Internal crawler-service URL. Server-to-server, so we use localhost.
# The Next.js /v1/* and /v2/* routes proxy to this URL.
CRAWLER_SERVICE_URL=http://localhost:3004

# Public base URL advertised in job poll URLs returned to API clients.
# In production this should be your deployed domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# API key authentication (read by BOTH the Next.js app and the
# crawler-service — set the same value in both .env files)
# ------------------------------------------------------------

# Comma-separated list of accepted API keys. Clients must present one
# of these via "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Leave empty/unset to disable auth (open access — not recommended
# for public deployments).
#
# Example (3 keys):
# CRAWLER_API_KEYS=nbc_key_abc123,nbc_key_def456,nbc_key_ghi789
#
# Single key (backwards-compatible shorthand):
# CRAWLER_API_KEY=nbc_key_abc123

# ------------------------------------------------------------
# Crawler-service configuration (put in mini-services/crawler-service/.env)
# ------------------------------------------------------------

# Port the crawler HTTP server listens on.
CRAWLER_PORT=3004

# Max in-flight Playwright page renders. Raising this uses more CPU/RAM
# but speeds up batch scraping. Lower it on memory-constrained hosts.
CRAWLER_MAX_CONCURRENCY=4

# Default navigation timeout in milliseconds.
CRAWLER_TIMEOUT=45000

# Default max pages per crawl job.
CRAWLER_CRAWL_LIMIT=20

# Default max crawl depth (BFS recursion levels). 1 = only the seed
# page's direct links; 2 = two levels deep, etc. Max 5 to prevent
# runaway crawls.
CRAWLER_CRAWL_MAX_DEPTH=2

# How long to keep finished job results in memory (ms). Default 30 min.
CRAWLER_JOB_TTL_MS=1800000

# Run the browser headless. Set to false only for debugging.
CRAWLER_HEADLESS=true

# Default user agent for the headless browser. This is the "advertised"
# UA — the crawler also rotates through a pool of realistic browser UAs
# for anti-bot evasion during scraping.
CRAWLER_USER_AGENT=NodeByte Crawl/2.0 (+https://github.com/nodebyte/crawl)

# Rotating user-agent pool (newline-separated). The crawler picks a
# random one per request to evade anti-bot fingerprinting. Leave unset
# to use the built-in pool of 5 desktop browser UAs.
# CRAWLER_USER_AGENT_POOL=UA1
# UA2
# UA3

# Default viewport size.
CRAWLER_VIEWPORT_WIDTH=1280
CRAWLER_VIEWPORT_HEIGHT=800

# Comma-separated Playwright resource types to block for speed.
# Set to an empty string to block nothing (slower but more accurate).
CRAWLER_BLOCK_RESOURCES=media,image,font

# Max retries on 403/429/503/network errors (with exponential backoff).
CRAWLER_MAX_RETRIES=2

# Base delay for exponential backoff (ms). Actual delay = base * 2^attempt.
CRAWLER_RETRY_BASE_DELAY=800

# Enable stealth anti-detection patches (navigator.webdriver removal,
# plugin spoofing, chrome stub, etc.). Disable only for debugging.
CRAWLER_STEALTH=true

# Auto-dismiss cookie consent banners (GDPR walls) before extraction.
CRAWLER_DISMISS_COOKIE_BANNERS=true

# Public base URL advertised in job poll URLs (usually the Next.js app URL).
CRAWLER_PUBLIC_URL=http://localhost:3000

# Brand name shown in health-check responses and logs.
CRAWLER_BRAND_NAME=NodeByte Crawl

# ------------------------------------------------------------
# Search engine aggregation (used by /v1/search, /v2/search, /search)
# ------------------------------------------------------------

# Comma-separated list of search engines to query. Default: all working engines.
# Options: bing, duckduckgo, searxng, wikipedia
# Mojeek, Brave, and Startpage have been removed (they consistently fail
# due to anti-bot protection). If an engine fails, the others still
# return results — failures are tolerated, not fatal.
# CRAWLER_SEARCH_ENGINES=bing,duckduckgo,searxng,wikipedia

# Default max results per search query.
CRAWLER_SEARCH_LIMIT=20

# Search result cache TTL in milliseconds (0 = disable cache).
CRAWLER_SEARCH_CACHE_TTL_MS=1800000

# Default search language. Options:
#   "all"  — mixed results from all languages (no locale restriction)
#   "auto" — auto-detect query language (CJK→zh/ja/ko, Cyrillic→ru, etc.)
#   "en"/"zh"/"ja"/"ko"/"fr"/"de"/"es"/"pt"/"ru"/"it" — restrict to that language
CRAWLER_SEARCH_LANG=auto

# Custom SearXNG instances (open-source meta-search framework).
# Format: "DisplayName|https://base-url,DisplayName2|https://base-url2"
# These are tried IN ADDITION to the built-in public instances.
# SearXNG aggregates Google/Bing/DuckDuckGo results, giving broader coverage
# than any single engine. Self-host your own for reliability:
#   https://docs.searxng.org/admin/installation.html
# Example:
# CRAWLER_SEARXNG_INSTANCES=My Searx|https://searx.example.com,Public|https://searx.be

# ------------------------------------------------------------
# Path to a custom Chromium executable. Leave empty to auto-detect
# the bundled browser (in ./browsers/) or the Playwright-managed browser.
# ------------------------------------------------------------
# CRAWLER_BROWSER_PATH=/usr/bin/chromium

# When packaging for distribution, set this to the bundled browsers dir
# so the service finds the binary on any host without `playwright install`.
# PLAYWRIGHT_BROWSERS_PATH=./browsers

# ------------------------------------------------------------
# Database (Prisma / SQLite) — used for optional persistent job storage
# ------------------------------------------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db
