# ============================================================
# NodeByte Crawl v3.0 — Environment Configuration (Single Port)
# ============================================================
# Since v3.0, the crawler runs IN the Next.js process — no separate
# mini-service. One port serves both the docs page AND the API.
# Copy this file to `.env.local` and adjust as needed.
# ============================================================

# ------------------------------------------------------------
# Server configuration
# ------------------------------------------------------------

# Port for the single Next.js server (docs + API on the same port).
PORT=3000

# Public base URL advertised in job poll URLs + code examples.
# In production this should be your deployed domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# API key authentication (multi-key support)
# ------------------------------------------------------------

# Comma-separated list of accepted API keys. Clients must present one
# via "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Leave empty/unset to disable auth (open access — not recommended
# for public deployments).
#
# Example (3 keys):
# CRAWLER_API_KEYS=nbc_key_abc123,nbc_key_def456,nbc_key_ghi789
#
# Single key (backwards-compatible shorthand):
# CRAWLER_API_KEY=nbc_key_abc123

# ------------------------------------------------------------
# Crawler (Playwright) configuration
# ------------------------------------------------------------

# Max in-flight Playwright page renders for FOREGROUND requests
# (sync /v2/scrape, /v2/scrape/batch). These are quick single-page scrapes.
CRAWLER_MAX_CONCURRENCY=4

# Max in-flight page renders for BACKGROUND jobs (async batch/crawl).
# Lower than foreground to reserve resources for quick requests.
# Each render uses a FRESH browser context — no cookie leakage between
# concurrent requests or pages. Like incognito mode, one context per page.
CRAWLER_BACKGROUND_CONCURRENCY=2

# Default navigation timeout in milliseconds.
CRAWLER_TIMEOUT=45000

# Default max pages per crawl job.
CRAWLER_CRAWL_LIMIT=20

# Default max crawl depth (BFS recursion levels). 1 = only the seed
# page's direct links; 2 = two levels deep. Max 5.
CRAWLER_CRAWL_MAX_DEPTH=2

# How long to keep finished job results in memory (ms). Default 30 min.
CRAWLER_JOB_TTL_MS=1800000

# Run the browser headless. Set to false only for debugging.
CRAWLER_HEADLESS=true

# Default user agent — the "advertised" UA. The crawler also rotates
# through a pool of realistic browser UAs for anti-bot evasion.
CRAWLER_USER_AGENT=NodeByte Bot/3.8.8P

# Website URL appended to every UA as an identifier.
# This is a WEBSITE URL (not a repo URL) so site admins can identify
# the crawler and visit the site to learn more / contact the operator.
# Format: "Mozilla/5.0 (compatible; NodeByte Bot/3.8.8P; +https://your-site.com)"
CRAWLER_UA_SITE_URL=https://nodebyte.cn

# Brand name shown in health-check + appended to UA.
CRAWLER_BRAND_NAME=NodeByte Crawl

# Default device emulation for scraping:
#   "auto"     - 50/50 random desktop vs mobile
#   "desktop"  - always desktop UA + large viewport
#   "mobile"   - always mobile UA + small viewport + touch
CRAWLER_DEFAULT_DEVICE=auto

# Default viewport size.
CRAWLER_VIEWPORT_WIDTH=1280
CRAWLER_VIEWPORT_HEIGHT=800

# Comma-separated Playwright resource types to block for speed.
# Set to empty string to block nothing (slower but more accurate).
# Note: when 'screenshot' or 'html' format is requested, images are
# automatically unblocked for faithful rendering.
CRAWLER_BLOCK_RESOURCES=media,image,font

# Max retries on 403/429/503/network errors (exponential backoff).
CRAWLER_MAX_RETRIES=2

# Base delay for exponential backoff (ms).
CRAWLER_RETRY_BASE_DELAY=800

# Enable stealth anti-detection patches.
CRAWLER_STEALTH=true

# Auto-dismiss cookie consent banners before extraction.
CRAWLER_DISMISS_COOKIE_BANNERS=true

# ------------------------------------------------------------
# Search engine aggregation
# ------------------------------------------------------------

# Engines to query (default: all working engines).
# Options: bing, duckduckgo, searxng, wikipedia
# If an engine fails, the others still return results.
# CRAWLER_SEARCH_ENGINES=bing,duckduckgo,searxng,wikipedia

# Default max results per search query.
CRAWLER_SEARCH_LIMIT=50

# Search result cache TTL in milliseconds (0 = disable).
CRAWLER_SEARCH_CACHE_TTL_MS=1800000

# Default search language. Options:
#   "auto" — auto-detect query language (CJK→zh/ja/ko, Cyrillic→ru, etc.)
#   "all"  — mixed results from all languages
#   "en"/"zh"/"ja"/"ko"/"fr"/"de"/"es"/"pt"/"ru"/"it" — restrict to that language
CRAWLER_SEARCH_LANG=auto

# Custom SearXNG instances (open-source meta-search framework).
# Format: "DisplayName|https://base-url,DisplayName2|https://base-url2"
# OR URL-only: "https://base-url1,https://base-url2" (name auto-derived
# from the hostname, with leading "searx."/"searxng."/"www." stripped).
# These are tried IN ADDITION to the built-in public instances.
# SearXNG aggregates Google/Bing/DuckDuckGo results.
# Self-host your own: https://docs.searxng.org/admin/installation.html
# Example:
# CRAWLER_SEARXNG_INSTANCES=My Searx|https://searx.example.com,Public|https://searx.be

# ------------------------------------------------------------
# Robots.txt + AI opt-out compliance (safety configuration)
# ------------------------------------------------------------
# Allow clients to override robots.txt via `ignoreRobotsTxt: true` in
# their request body. Default off (only the operator can flip this).
# When off, any request that sets ignoreRobotsTxt is silently ignored.
# AI opt-out layers (X-Robots-Tag: noai, <meta> robots, CC-NOAI,
# TDM-Rep) are NEVER bypassable — they are hard legal compliance.
# CRAWLER_ALLOW_ROBOTS_OVERRIDE=false

# Honour <meta name="robots" content="noindex"> and X-Robots-Tag:
# noindex as a soft AI opt-out (blocks scraping, not just indexing).
# Default off — noindex is traditionally a search-engine directive,
# not a crawler directive. Set to true to be strict.
# CRAWLER_RESPECT_NOINDEX=false

# Cache TTL (ms) for per-host robots.txt and ai.txt fetches.
# Default 1 hour (3600000 ms). Lower this for testing.
# CRAWLER_ROBOTS_CACHE_TTL_MS=3600000

# ------------------------------------------------------------
# Response size limits
# ------------------------------------------------------------
# Maximum response body size in bytes for non-Playwright fetches
# (sitemap.xml, robots.txt, search-engine HTML pages). Default 50 MB.
# CRAWLER_MAX_BODY_BYTES=52428800

# ------------------------------------------------------------
# Path to a custom Chromium executable. Leave empty to auto-detect
# the bundled browser (in ./browsers/) or Playwright's default.
# ------------------------------------------------------------
# CRAWLER_BROWSER_PATH=/usr/bin/chromium

# When packaging for distribution, set this to the bundled browsers dir
# so the service finds the binary on any host without `playwright install`.
# PLAYWRIGHT_BROWSERS_PATH=./browsers

# ------------------------------------------------------------
# Database (Prisma / SQLite) — optional, for persistent job storage
# ------------------------------------------------------------
DATABASE_URL=mysql://root:password@localhost:3306/nodebyte
